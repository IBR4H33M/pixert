{
  "expo": {
    "name": "Pixert",
    "slug": "pixert-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "description": "Create stunning panoramic Instagram carousels in seconds. Split your wide images into perfect carousel posts.",
    "platforms": ["ios", "android"],
    "sdkVersion": "54.0.0",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#97C8C9"
    },
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pixert.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#97C8C9"
      },
      "edgeToEdge": true,
      "versionCode": 10,
      "package": "com.pixert.app",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Pixert to save carousel images to your photo library.",
          "savePhotosPermission": "Allow Pixert to save carousel images to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "visible",
          "backgroundColor": "#00000000"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d5ea98a3-1a0d-4cfc-b2de-16f48f4d393d"
      }
    }
  }
}
